# Development: node --env-file=.env services/api/src/server.mjs
# These sample credentials are for local development only.
# MADAR_DEMO=1 fills the database with sample content and demo screens. Use 0 for real data.
MADAR_DEMO=1
PORT=8000
BOOTSTRAP_EMAIL=admin@madar.local
BOOTSTRAP_PASSWORD=MadarDemo!2026#
# Optional during development. Production requires DATABASE_URL and HTTPS.
# DATABASE_URL=postgresql://madar:YOUR_URL_ENCODED_PASSWORD@localhost:5432/madar
REDIS_URL=redis://127.0.0.1:6379
# All API nodes must agree on an optional stream override:
# REDIS_DELIVERY_STREAM=madar:{delivery}:updates
# APP_ORIGIN=https://madar.example.org
# INTEGRATION_KEY=GENERATE_A_RANDOM_32_BYTE_SECRET
# MEDIA_SOURCES_JSON={"LOCAL-01":"https://your-provider.example/live/channel1.m3u8"}
# ASSET_SCANNER=/usr/bin/clamscan
# Docker Compose production values (do not use the development password):
# MADAR_HOST=madar.example.org
# POSTGRES_PASSWORD=GENERATE_A_URL_SAFE_RANDOM_SECRET

# Per-minute API limits; authenticated TVs have independent quotas behind shared NAT.
# API_RATE_LIMIT=600
# DEVICE_RATE_LIMIT=180

# Odoo Help Desk / Daily Tasks: optional; overrides needing to save the API key in Admin > Integrations
# ODOO_API_KEY=
# SpaceHub display account password, if you prefer not to save it in Admin > Integrations.
# SPACEHUB_PASSWORD=
